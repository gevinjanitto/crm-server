{
	email {$ACME_EMAIL}
	default_sni {$SERVER_IP}
	cert_issuer acme {
		profile shortlived
		disable_tlsalpn_challenge
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	handle /api/* {
		reverse_proxy backend:8001
	}
	handle /.well-known/oauth-* {
		reverse_proxy backend:8001
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy backend:8001
	}
	handle {
		root * /srv
		@static path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		@pwa path /sw.js /manifest.json
		header @pwa Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
